# Copie para .env e ajuste. NUNCA versione o .env real.

# Porta interna da API (fica atrás do nginx)
PORT=8092

# Segredo do JWT — troque por um valor longo e aleatório em produção
# Gere um: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=troque-este-segredo-por-um-valor-aleatorio-e-longo

# Origem permitida do painel (CORS). Em produção, o domínio do admin.
# Ex: https://admin.mcflats.com.br  — em dev, o Vite (5174).
ADMIN_ORIGIN=http://localhost:5174

# Origem do site público (para o endpoint /api/public). Deixe * se preferir liberar.
PUBLIC_ORIGIN=*

# Cookie seguro (true em produção com HTTPS)
COOKIE_SECURE=false

# Credenciais do primeiro Super Admin (criado no primeiro boot se o banco estiver vazio)
SEED_ADMIN_NAME=Administrador MC Flats
SEED_ADMIN_EMAIL=admin@mcflats.com.br
SEED_ADMIN_PASSWORD=mcflats2026

# --- Integração Stays (PMS) — peça as chaves na tela "Chaves da API" do Stays ---
STAYS_BASE_URL=https://SUA-CONTA.stays.com.br
STAYS_CLIENT_ID=seu_client_id
STAYS_CLIENT_SECRET=seu_client_secret

# --- Criptografia de CPF/cartão em repouso (AES-256-GCM) ---
# Gere 32 bytes: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# NUNCA troque depois de gravar dados — invalida tudo o que já foi cifrado.
CPF_ENC_KEY=

# --- Login com Google (opcional) — Client ID público do Google Cloud ---
GOOGLE_CLIENT_ID=

# NODE_ENV=production  (ativa os guarda-corpos de produção)
